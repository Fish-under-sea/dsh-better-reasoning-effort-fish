{
  "name": "dsh-better-reasoning-effort-fish",
  "version": "0.5.7",
  "description": "第三方模型的思考强度与输入模态设置（DeepSeek Harness 插件，Fish 补充版）：每模型声明思考档位与图片输入，由内置模型知识库 + 线协议推断自动适配，直接在官方「模型」页卡片内编辑。基于上游 dsh-better-reasoning-effort 0.5.2，修复了与 dsh-web 模型能力插件的席位冲突。",
  "license": "MIT",
  "author": {
    "name": "Fish-under-sea",
    "url": "https://github.com/Fish-under-sea"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fish-under-sea/dsh-better-reasoning-effort-fish.git"
  },
  "homepage": "https://github.com/Fish-under-sea/dsh-better-reasoning-effort-fish#readme",
  "bugs": {
    "url": "https://github.com/Fish-under-sea/dsh-better-reasoning-effort-fish/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reasoning-effort",
    "reasoning",
    "thinking",
    "input-modality",
    "modalities",
    "vision",
    "llm-settings",
    "fish"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.original.md",
    "README_ZH.original.md",
    "NOTICE.md",
    "FORK.md",
    "LICENSE",
    "assets/",
    "docs/*.svg",
    "icon.svg",
    "locale/*.json"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-alpha.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run build:clean && npm run build:host && npm run build:client && npm run build:types",
    "build:clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "check:styles": "node scripts/check-styles.mjs",
    "build:client": "npm run check:styles && node scripts/build-client.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "build:host": "node scripts/build-host.mjs",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-alpha.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.1.7-rc.1 || ^0.2.0-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.0",
    "jsdom": "^27.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
